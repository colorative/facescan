{
  "name": "facescan-kiosk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "UI design prototype for an attendee face-scan check-in kiosk",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "vendor:mediapipe": "node scripts/vendor-mediapipe.mjs",
    "postinstall": "node scripts/vendor-mediapipe.mjs",
    "dev:lan": "KIOSK_LAN=1 vite",
    "cert": "node scripts/dev-cert.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "motion": "^13.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  }
}
